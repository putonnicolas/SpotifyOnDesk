# Spotify API Credentials
# Create your application at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Spotify forbids 'http://localhost:...'. Use 'http://127.0.0.1:4000/' locally
# or your deployed Vercel domain 'https://your-app.vercel.app/'
VITE_REDIRECT_URI=http://127.0.0.1:4000/
